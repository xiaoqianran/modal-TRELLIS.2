# Copy to .env. First week: keep dry-run on and never touch Modal.

MODAL_TRELLIS2_DRY_RUN=1
MODAL_TRELLIS2_PORT=7863
MODAL_TRELLIS2_DATA_DIR=data
MODAL_TRELLIS2_GPU=A100-80GB
MODAL_TRELLIS2_PIPELINE=512

# Required only when you leave dry-run and call the real TRELLIS.2-4B weights.
# The 4B card is currently public; HF_TOKEN still helps Modal Volume prefetch.
# HF_TOKEN=hf_...
